{
  "name": "shock-systems",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:guard": "tsx scripts/db-guard.ts",
    "db:local:migrate": "cross-env DATABASE_URL=postgresql://shock:shock123@localhost:5433/shock_db prisma migrate deploy",
    "db:local:seed": "cross-env DATABASE_URL=postgresql://shock:shock123@localhost:5433/shock_db tsx prisma/seed.ts",
    "db:local:studio": "cross-env DATABASE_URL=postgresql://shock:shock123@localhost:5433/shock_db prisma studio",
    "dev:local": "cross-env DATABASE_URL=postgresql://shock:shock123@localhost:5433/shock_db MOBILE_JWT_SECRET=dev-only-mobile-jwt-secret-solo-para-desarrollo-local next dev",
    "test": "vitest run",
    "mobile:smoke": "cross-env DATABASE_URL=postgresql://shock:shock123@localhost:5433/shock_db node --env-file-if-exists=.env.local scripts/mobile-smoke.mjs",
    "email:dev": "email dev"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-rekognition": "^3.1166.0",
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@hookform/resolvers": "^5.2.2",
    "@photo-sphere-viewer/core": "^5.14.3",
    "@photo-sphere-viewer/markers-plugin": "^5.14.3",
    "@prisma/client": "^5.22.0",
    "@react-email/components": "1.0.7",
    "@react-pdf/renderer": "^4.3.2",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.26.2",
    "ioredis": "^5.10.1",
    "jose": "6.1.3",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.10",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-hot-toast": "^2.6.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.4.0",
    "three": "^0.184.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@react-email/preview-server": "5.2.8",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.10",
    "react-email": "5.2.8",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
